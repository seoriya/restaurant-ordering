# Copy this file to .env.local and fill in the values.
# NONE of these are sent to customers' phones — they are only read on the server.

# Supabase → your project → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...)  KEEP PRIVATE
SUPABASE_SECRET_KEY=

# HitPay sandbox dashboard → Settings → Payment Gateway → API Keys
HITPAY_API_KEY=
HITPAY_SALT=
# Sandbox while testing. Change to https://api.hit-pay.com for real payments.
HITPAY_API_BASE=https://api.sandbox.hit-pay.com

# Password for the /staff page (pick anything long)
STAFF_PASSWORD=

# The website's address. Local: http://localhost:3000  Online: https://your-site.vercel.app
APP_URL=http://localhost:3000
